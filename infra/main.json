              "value": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]",
                "name": "[parameters('vnetName')]",
                "addressSpace": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').addressSpace.addressPrefixes[0]]",
                "subnets": {
                  "fwSubnet": {
                    "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').subnets[0].id]",
                    "name": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').subnets[0].name]",
                    "addressPrefix": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').subnets[0].properties.addressPrefix]"
                  },
                  "monSubnet": {
                    "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').subnets[1].id]",
                    "name": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').subnets[1].name]",
                    "addressPrefix": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), '2023-11-01').subnets[1].properties.addressPrefix]"
                  }
                }
              }
            }
          }
        }
