        "mode": "Incremental",
        "parameters": {
          "containerGroupName": {
            "value": "[format('aci-fwsyslog-{0}', parameters('environmentName'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "subnetId": {
            "value": "[reference('vnetModule').outputs.vnet.value.subnets.fwSubnet.id]"
          },
          "serverPrivateIP": {
            "value": "[reference('vmModule').outputs.vm.value.privateIP]"
          },
          "containerImage": {
            "value": "acrdefcontainer.azurecr.io/fwsyslogemulator:latest"
          },
          "registryServer": {
            "value": "[parameters('registryServer')]"
          },
          "registryUsername": {
            "value": "[parameters('registryUsername')]"
          },
          "registryPassword": {
            "value": "[parameters('registryPassword')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.38.33.27573",
              "templateHash": "9041732090690302985"
            }
          },
          "parameters": {
            "containerGroupName": {
              "type": "string",
              "metadata": {
                "description": "Name of the container group"
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]",
              "metadata": {
                "description": "Location for the container group"
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Tags to apply to the container group"
              }
            },
            "subnetId": {
              "type": "string",
              "metadata": {
                "description": "Subnet ID where the container will be deployed"
              }
            },
            "serverPrivateIP": {
              "type": "string",
              "metadata": {
                "description": "Private IP address of the server (VM)"
              }
            },
            "containerImage": {
              "type": "string",
              "defaultValue": "acrdefcontainer.azurecr.io/fwsyslogemulator:latest",
              "metadata": {
                "description": "Container image to deploy"
              }
            },
            "cpuCores": {
              "type": "int",
              "defaultValue": 1,
              "metadata": {
                "description": "CPU cores for the container"
              }
            },
            "memoryInGB": {
              "type": "int",
              "defaultValue": 1,
              "metadata": {
                "description": "Memory in GB for the container"
              }
            },
            "registryServer": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Container registry server (optional)"
              }
            },
            "registryUsername": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Container registry username (optional)"
              }
            },
            "registryPassword": {
              "type": "securestring",
              "defaultValue": "",
              "metadata": {
                "description": "Container registry password (optional)"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerInstance/containerGroups",
              "apiVersion": "2023-05-01",
              "name": "[parameters('containerGroupName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "containers": [
                  {
                    "name": "fwsyslogemulator",
                    "properties": {
                      "image": "[parameters('containerImage')]",
                      "command": [
                        "python",
                        "/app/simulatesyslog.py",
                        "--server",
                        "[parameters('serverPrivateIP')]"
                      ],
                      "resources": {
                        "requests": {
                          "cpu": "[parameters('cpuCores')]",
                          "memoryInGB": "[parameters('memoryInGB')]"
                        }
                      },
                      "environmentVariables": [
                        {
                          "name": "SERVER_IP",
                          "value": "[parameters('serverPrivateIP')]"
                        }
                      ]
                    }
                  }
                ],
                "osType": "Linux",
                "restartPolicy": "Always",
                "subnetIds": [
                  {
                    "id": "[parameters('subnetId')]"
                  }
                ],
                "imageRegistryCredentials": "[if(not(empty(parameters('registryServer'))), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'password', parameters('registryPassword'))), createArray())]"
              }
            }
          ],
          "outputs": {
            "containerGroup": {
              "type": "object",
              "metadata": {
                "description": "Container group information"
              },
              "value": {
                "id": "[resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName'))]",
                "name": "[parameters('containerGroupName')]",
                "provisioningState": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName')), '2023-05-01').provisioningState]"
